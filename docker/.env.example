# Copy to docker/.env and fill in before running `docker compose up` from
# inside the docker/ folder (compose auto-loads .env next to the compose
# file for ${VAR} substitution in docker-compose.yml).
#
# C6 secrets (C6_CLIENT_ID, C6_CLIENT_SECRET, C6_WEBHOOK_PATH_SECRET, etc.)
# are NOT duplicated here: the banking service loads them straight from
# the root ../.env via `env_file` in docker-compose.yml, so there's a
# single place to manage them regardless of how you run the app. Copy
# ../.env.example to ../.env and fill that in too.

POSTGRES_USER=banking
POSTGRES_PASSWORD=banking
POSTGRES_DB=banking
POSTGRES_PORT=7532

HTTP_PORT=8082

# Absolute or ../-relative host paths to the sandbox credentials provided
# by C6 (already present under ../docs/c6/auth/, excluded from git). These
# are bind-mounted read-only into the container; the in-container path is
# fixed in docker-compose.yml (/certs/c6.crt, /certs/c6.key).
C6_CERT_FILE=../docs/c6/auth/crt - LEOANARDO ALVES DE PAULA E SILVA.txt
C6_KEY_FILE=../docs/c6/auth/key - LEOANARDO ALVES DE PAULA E SILVA.txt
