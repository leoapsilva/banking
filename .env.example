HTTP_ADDR=:8080

DATABASE_URL=postgres://user:password@localhost:5432/banking?sslmode=disable

C6_ENV=sandbox
C6_CLIENT_ID=
C6_CLIENT_SECRET=
# Point these at the .crt/.key files already provided in docs/c6/auth/
# (never commit them; they are excluded via .gitignore).
C6_MTLS_CERT_PATH=
C6_MTLS_KEY_PATH=
C6_PARTNER_SOFTWARE_NAME=banking
C6_PARTNER_SOFTWARE_VERSION=0.1.0

# Used to validate inbound webhook notifications, since C6 documents no
# HMAC signature for them.
C6_EXPECTED_CLIENT_ID=
C6_EXPECTED_PARTNER_ID=

# Appended to /webhooks/c6/ as a path token for minimal obscurity.
C6_WEBHOOK_PATH_SECRET=

# InfinitePay checkout provider (optional — leave blank if not using InfinitePay)
# INFINITEPAY_BASE_URL defaults to https://api.checkout.infinitepay.io
INFINITEPAY_BASE_URL=
INFINITEPAY_HANDLE=
# The two settings below MUST agree — the service refuses to start otherwise.
#
# The token is NOT something you get from InfinitePay: you invent it. It
# becomes the last segment of the route this service registers:
#
#     POST /webhooks/infinitepay/<token>
#
# and INFINITEPAY_WEBHOOK_URL is that same route, spelled as the public
# address InfinitePay should call. We send that URL on every checkout, so it
# has to end with exactly the token below.
#
# Generate once with:  openssl rand -hex 16
#
# Treat it as durable, not disposable: every checkout already created carries
# this URL, so changing the token breaks payment notifications for links that
# are still awaiting payment.
#
# It is obscurity, not authentication — a URL token shows up in proxy logs.
# The real defence is elsewhere: a PAID webhook reporting less than the
# checkout amount is refused (internal/billing/service/webhook_validation.go).
INFINITEPAY_WEBHOOK_URL=
INFINITEPAY_WEBHOOK_PATH_SECRET=
# Pre-created monthly plan link from InfinitePay app (returned by GET /v1/subscriptions/infinitepay/plans/monthly).
# Leave blank if monthly plan is not offered; the endpoint returns 503 when empty.
INFINITEPAY_PLAN_MONTHLY_URL=

CRON_CHARGE_INTERVAL=@hourly

# API keys of the services allowed to call this API, as "name:secret" pairs
# separated by commas. Callers send the secret in the X-API-Key header; the
# name is what shows up in the logs and scopes ownership.
#
#   API_KEYS=cores:<secret>,outro-servico:<secret>
#
# Generate each secret with:  openssl rand -base64 32
#
# The same secret goes into the consumer's own config — for the Cores
# backend, as BANKING_API_KEY alongside BANKING_URL=http://banking:8082.
#
# /healthz and /webhooks/* are exempt: providers call the webhook paths and
# cannot hold our key (they carry their own path secret instead).
#
# Leaving this blank makes EVERY route anonymous — including subscription
# cancellation. The service logs a warning at startup and starts anyway,
# which is only acceptable for local development.
API_KEYS=

# debug | info | warn | error. JSON logs to stdout.
LOG_LEVEL=info
# Logs raw HTTP request/response bodies at debug level when true (never
# logs headers, so Authorization/bearer tokens are never written to logs
# regardless of this flag). Useful for debugging, but bodies can contain
# payer PII (CPF, email) — keep false outside local debugging.
LOG_HTTP_BODY=false
