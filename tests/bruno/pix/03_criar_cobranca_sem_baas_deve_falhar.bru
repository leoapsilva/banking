meta {
  name: 03 Criar cobranca sem baas (deve falhar)
  type: http
  seq: 3
}

post {
  url: {{base_url}}/v1/pix/charges
  body: json
  auth: none
}

body:json {
  {
    "amount_cents": 10000,
    "pix_key": "{{pix_key}}",
    "expiration_seconds": 3600
  }
}

assert {
  res.status: eq 400
  res.body.error: isDefined
}
