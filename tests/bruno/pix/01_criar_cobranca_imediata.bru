meta {
  name: 01 Criar cobranca imediata, com expiracao em segundos
  type: http
  seq: 1
}

post {
  url: {{base_url}}/v1/pix/charges
  body: json
  auth: none
}

body:json {
  {
    "baas": "{{baas}}",
    "amount_cents": 10000,
    "pix_key": "{{pix_key}}",
    "expiration_seconds": 3600,
    "payer_request": "Cobranca de teste via Bruno"
  }
}

assert {
  res.status: eq 201
  res.body.txid: isDefined
  res.body.kind: eq IMMEDIATE
}

script:post-response {
  if (res.status === 201) {
    bru.setEnvVar("pix_txid_immediate", res.body.txid);
  }
}
