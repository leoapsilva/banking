meta {
  name: 08 Criar link de checkout credito com save_card true (Opcional)
  type: http
  seq: 8
}

post {
  url: {{base_url}}/v1/checkouts
  body: json
  auth: none
}

script:pre-request {
  // external_reference_id deve ser unico por conta C6 e tem no maximo 10
  // caracteres alfanumericos (docs/c6/swagger/checkout-c6-bank.yaml) —
  // deriva do timestamp atual para que reruns nao colidam com checkouts
  // criados anteriormente.
  bru.setVar("ext_ref", "F" + Date.now().toString(36).toUpperCase().slice(-9));
}

body:json {
  {
    "baas": "{{baas}}",
    "external_reference_id": "{{ext_ref}}",
    "amount_cents": 12345,
    "currency": "BRL",
    "description": "Checkout de teste via Bruno - save_card",
    "payer": {
      "name": "Jose da Silva",
      "tax_id": "12345678909",
      "email": "pagador@email.com.br",
      "phone_number": "11999999999",
      "address": {
        "street": "Av. Nove de Julho",
        "number": "123",
        "city": "Rio de Janeiro",
        "state": "RJ",
        "zip_code": "05093000"
      }
    },
    "card": {
      "type": "CREDIT",
      "installments": 1,
      "recurrent": false,
      "save_card": true,
      "capture": true,
      "authenticate": "NOT_REQUIRED"
    },
    "redirect_url": "http://www.seusite.com.br/finalizaPedido"
  }
}

assert {
  res.status: eq 201
  res.body.id: isDefined
  res.body.url: isDefined
}

script:post-response {
  if (res.status === 201) {
    bru.setEnvVar("checkout_id", res.body.id);
  }
}
