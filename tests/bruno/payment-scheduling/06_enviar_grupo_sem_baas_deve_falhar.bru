meta {
  name: 06 Enviar grupo sem baas (deve falhar)
  type: http
  seq: 6
}

post {
  url: {{base_url}}/v1/payment-scheduling/groups
  body: json
  auth: none
}

body:json {
  {
    "items": [
      { "content": "{{pix_key}}", "amount_cents": 1000 }
    ]
  }
}

assert {
  res.status: eq 400
  res.body.error: isDefined
}
