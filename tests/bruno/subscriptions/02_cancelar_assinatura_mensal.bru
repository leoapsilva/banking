meta {
  name: 02 Cancelar assinatura mensal recem-criada
  type: http
  seq: 2
}

put {
  url: {{base_url}}/v1/subscriptions/{{monthly_subscription_id}}/cancel
  body: json
  auth: none
}

body:json {
  {
    "reason": "Cancelado via teste Bruno",
    "refund_current_cycle": false
  }
}

assert {
  res.status: eq 204
}
