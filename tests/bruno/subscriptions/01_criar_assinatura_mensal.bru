meta {
  name: 01 Criar assinatura mensal (caso feliz)
  type: http
  seq: 1
}

post {
  url: {{base_url}}/v1/subscriptions/monthly
  body: json
  auth: none
}

body:json {
  {
    "baas": "{{baas}}",
    "customer_name": "Jose da Silva",
    "customer_tax_id": "12345678909",
    "customer_email": "pagador@email.com.br",
    "amount_cents": 9990,
    "currency": "BRL",
    "redirect_url": "http://www.seusite.com.br/finalizaPedido"
  }
}

assert {
  res.status: eq 201
  res.body.subscription_id: isDefined
  res.body.checkout_id: isDefined
  res.body.checkout_url: isDefined
}

script:post-response {
  if (res.status === 201) {
    bru.setEnvVar("monthly_subscription_id", res.body.subscription_id);
  }
}
