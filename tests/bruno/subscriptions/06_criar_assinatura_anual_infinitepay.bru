meta {
  name: 06 Criar assinatura anual InfinitePay (checkout link)
  type: http
  seq: 6
}

post {
  url: {{base_url}}/v1/subscriptions/annual
  body: json
  auth: none
}

body:json {
  {
    "baas": "infinitepay",
    "customer_name": "Maria Souza",
    "customer_tax_id": "12345678909",
    "customer_email": "maria@email.com",
    "amount_cents": 150000,
    "currency": "BRL",
    "redirect_url": "https://seusite.com/assinatura/concluida"
  }
}

assert {
  res.status: eq 201
  res.body.subscription_id: isDefined
  res.body.checkout_id: isDefined
  res.body.checkout_url: isDefined
}

script:post-response {
  if (res.status === 201) {
    bru.setEnvVar("infinitepay_subscription_id", res.body.subscription_id);
    bru.setEnvVar("infinitepay_checkout_id", res.body.checkout_id);
  }
}
