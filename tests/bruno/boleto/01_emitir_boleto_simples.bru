meta {
  name: 01 Emitir boleto simples (sem juros, multa ou desconto)
  type: http
  seq: 1
}

post {
  url: {{base_url}}/v1/bank-slips
  body: json
  auth: none
}

script:pre-request {
  // external_reference_id must be unique per C6 account and is capped at
  // 10 alphanumeric chars (docs/c6/swagger/boleto-bancário.yaml) — derive
  // it from the current timestamp so reruns don't collide with a
  // previously issued bank slip.
  bru.setVar("ext_ref", "A" + Date.now().toString(36).toUpperCase().slice(-9));
}

body:json {
  {
    "baas": "{{baas}}",
    "external_reference_id": "{{ext_ref}}",
    "amount_cents": 20000,
    "currency": "BRL",
    "due_date": "2026-12-31",
    "instructions": ["Nao receber apos o vencimento"],
    "payer": {
      "name": "Jose da Silva",
      "tax_id": "12345678909",
      "email": "pagador@email.com.br",
      "address": {
        "street": "Av. Nove de Julho",
        "number": "123",
        "city": "Rio de Janeiro",
        "state": "RJ",
        "zip_code": "05093000"
      }
    }
  }
}

assert {
  res.status: eq 201
  res.body.id: isDefined
  res.body.bar_code: isDefined
  res.body.digitable_line: isDefined
}

script:post-response {
  if (res.status === 201) {
    bru.setEnvVar("bank_slip_id", res.body.id);
  }
}
