meta {
  name: 03 Emitir boleto com desconto escalonado por dias antes do vencimento
  type: http
  seq: 3
}

post {
  url: {{base_url}}/v1/bank-slips
  body: json
  auth: none
}

script:pre-request {
  bru.setVar("ext_ref", "C" + Date.now().toString(36).toUpperCase().slice(-9));
}

body:json {
  {
    "baas": "{{baas}}",
    "external_reference_id": "{{ext_ref}}",
    "amount_cents": 30000,
    "currency": "BRL",
    "due_date": "2026-12-31",
    "discount": {
      "tiers": [
        { "type": "PERCENTAGE", "value": 10, "deadline_days": 10 },
        { "type": "PERCENTAGE", "value": 5, "deadline_days": 5 },
        { "type": "PERCENTAGE", "value": 2, "deadline_days": 1 }
      ]
    },
    "payer": {
      "name": "Jose da Silva",
      "tax_id": "12345678909",
      "email": "pagador@email.com.br",
      "address": {
        "street": "Av. Nove de Julho",
        "number": "123",
        "city": "Rio de Janeiro",
        "state": "RJ",
        "zip_code": "05093000"
      }
    }
  }
}

assert {
  res.status: eq 201
  res.body.id: isDefined
}
