meta {
  name: 19 Aplicar baixa do boleto vencido (roteiro 4.b - aproximacao, ver 18)
  type: http
  seq: 19
}

docs {
  Ver comentario completo em boleto/18_baixar_boleto_vencido.bru sobre a
  limitacao deste item do roteiro: nao conseguimos criar, via nossa API,
  um boleto genuinamente vencido (due_date no passado e rejeitado na
  criacao). Este arquivo apenas aplica a baixa, no mesmo dia do
  vencimento, ao boleto emitido em boleto/18. O assert abaixo e
  tolerante (mesmo padrao de boleto/07 e boleto/09): aceitamos 204
  (baixa concluida) ou o bloqueio esperado de CIP pendente, mas NAO
  validamos o comportamento real do C6 para um boleto vencido ha mais
  tempo -- isso requer um teste manual (ver boleto/18).
}

script:pre-request {
  const waitMs = Number(bru.getVar('cip_settle_wait_ms')) || 90000;
  const start = Date.now();
  while (Date.now() - start < waitMs) {
    // busy-wait intencional
  }
}

put {
  url: {{base_url}}/v1/bank-slips/{{bank_slip_id_18}}/cancel?baas={{baas}}
  auth: none
}

tests {
  test("baixa aceita ou bloqueada pela CIP pendente (ambos esperados) -- ver limitacao em boleto/18", function() {
    const status = res.getStatus();
    const body = res.getBody();
    const isSuccess = status === 204;
    const isCipPending =
      status === 502 &&
      body &&
      typeof body.error === "string" &&
      body.error.includes("CIP sujeita");
    expect(isSuccess || isCipPending).to.be.true;
  });
}
